# App connection: Supabase transaction pooler (port 6543).
# For the optional local Docker DB instead: postgres://postgres:postgres@localhost:54329/accountability
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations: Supabase session pooler (port 5432). Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Admin/research interface (/admin). Use a long random value in any shared environment.
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-32-byte-hex

# When "true", records flagged is_demo are excluded from public pages.
# Defaults to true when NODE_ENV=production.
HIDE_DEMO_DATA=false
