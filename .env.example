# Postgres connection string.
# Local: matches docker-compose.yml. Production: Supabase pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/accountability

# Admin/research interface (/admin). Use a long random value in any shared environment.
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-32-byte-hex

# When "true", records flagged is_demo are excluded from public pages.
# Defaults to true when NODE_ENV=production.
HIDE_DEMO_DATA=false
